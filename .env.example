# ============================================================
# 库存运维 Agent 配置示例
# 复制为同目录的 .env 后填真实值；.env 已被 config.py 自动加载。
# 不要把这个文件提交进 git（含密钥）。
# ============================================================

# ── 1. LLM：DeepSeek（OpenAI 兼容协议）──
# 官网 https://platform.deepseek.com 申请；必填，真实模式需要。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_MAX_TOKENS=2048

# ── 2. 库存引擎（RESP 客户端连接目标）──
ENGINE_HOST=127.0.0.1
ENGINE_PORT=6379
ENGINE_TIMEOUT=2.0

# ── 3. 向量化：OpenAI 兼容 endpoint（DeepSeek 不提供 embedding）──
# 默认指向本地 Ollama（零费用、可离线）：先 `ollama pull nomic-embed-text`
# 也可用 OpenAI：https://api.openai.com/v1 + 对应模型
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_API_KEY=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768
EMBEDDING_BATCH=32

# ── 4. 离线冒烟：置 1 用哈希伪向量（不调 embedding API，仅验证链路）──
RAG_OFFLINE=1

# ── 5. 检索参数 ──
RAG_DENSE_TOP_K=20
RAG_SPARSE_TOP_K=20
RAG_RRF_K=60
RAG_FINAL_TOP_K=5
# RAG_INDEX_DIR=agent/rag/index_store   # 不填用默认
